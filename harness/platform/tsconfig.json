{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true
  },
  "include": [
    "values/**/*.ts",
    "lint/**/*.ts",
    "ledger/**/*.ts"
  ],
  "exclude": [
    "values/vendor/**",
    "dist",
    "node_modules"
  ]
}